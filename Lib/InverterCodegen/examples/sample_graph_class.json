          "frame": "scalar",
          "dtype": "f32"
        },
        "OutputMin": {
          "quantity": "dimensionless",
          "frame": "scalar",
          "dtype": "f32"
        },
        "AwGain": {
          "quantity": "dimensionless",
          "frame": "scalar",
          "dtype": "f32"
        }
      }
    }
