    {
      "id": "control.pi",
      "displayName": "PI Controller",
      "inputPorts": [
        {"name": "error", "direction": "input", "type": {"quantity": "dimensionless", "frame": "scalar", "dtype": "f32"}}
      ],
      "outputPorts": [
        {"name": "out", "direction": "output", "type": {"quantity": "dimensionless", "frame": "scalar", "dtype": "f32"}}
      ],
      "inlineCode": "out = instance.update(error);",
      "constructorCode": "instance.kp = kp; instance.ki = ki;",
      "classHeader": "class PiController { public: float kp; float ki; float integrator; float update(float error); };",
      "classDefinition": "float PiController::update(float error) { integrator += ki * error; return kp * error + integrator; }",
      "maxInstances": 0,
      "isEntryPoint": false
    },
    {
      "id": "sink.pwm",
      "displayName": "PWM Output",
      "inputPorts": [
        {"name": "in", "direction": "input", "type": {"quantity": "dimensionless", "frame": "scalar", "dtype": "f32"}}
      ],
      "outputPorts": [],
      "inlineCode": "platform_pwm_set(in, in, in);",
      "constructorCode": "",
      "classHeader": "",
      "classDefinition": "",
      "maxInstances": 0,
      "isEntryPoint": false
    }
  ],
  "nodes": [
    {
      "id": "setpoint",
      "type": "constant.value",
      "displayName": "Setpoint",
      "domain": "app_loop",
      "position": {"x": 0.0, "y": 0.0},
      "parameters": {"value": "1.0"}
    },
    {
      "id": "pi",
      "type": "control.pi",
      "displayName": "PI",
