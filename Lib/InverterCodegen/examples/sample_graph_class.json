          "frame": "scalar",
          "dtype": "f32"
        },
        "Ki": {
          "quantity": "dimensionless",
          "frame": "scalar",
          "dtype": "f32"
        },
        "Dt": {
          "quantity": "dimensionless",
          "frame": "scalar",
          "dtype": "f32"
        },
        "Integral": {
