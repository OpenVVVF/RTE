{
  "id": "Modulation.SixStep",
  "displayName": "Six-Step (Trapezoid)",
  "defaultName": "SixStep",
  "description": "PWM'd six-step (120 deg trapezoid) modulator for the ladder's top mode. Pattern is locked to the rotor electrical angle; the current loop enters only as magnitude and a smooth dq phase offset. Emits duties only when gated active by the sequencer.",
  "maxInstances": 1,
  "isEntryPoint": false,
  "domain": "tim_isr",
  "inputPorts": [
    {
      "name": "V_D",
      "description": "Commanded d-axis voltage (from the current loop, smooth).",
      "direction": "input",
      "type": {
        "quantity": "voltage",
        "frame": "scalar",
        "dtype": "f32"
      }
    },
    {
      "name": "V_Q",
      "description": "Commanded q-axis voltage (from the current loop, smooth).",
      "direction": "input",
      "type": {
        "quantity": "voltage",
        "frame": "scalar",
        "dtype": "f32"
      }
    },
    {
      "name": "Theta_E",
      "description": "Rotor electrical angle in radians (encoder-referenced).",
      "direction": "input",
      "type": {
        "quantity": "dimensionless",
        "frame": "scalar",
        "dtype": "f32"
      }
    },
    {
      "name": "V_Dc",
      "description": "DC-link voltage for magnitude normalization.",
      "direction": "input",
      "type": {
        "quantity": "voltage",
        "frame": "scalar",
        "dtype": "f32"
      }
    },
    {
      "name": "ModeFrom",
      "description": "Sequencer mode being left / current mode.",
      "direction": "input",
      "type": {
        "quantity": "dimensionless",
        "frame": "scalar",
        "dtype": "f32"
      }
    },
    {
      "name": "ModeTo",
      "description": "Sequencer incoming mode / current mode.",
      "direction": "input",
      "type": {
        "quantity": "dimensionless",
        "frame": "scalar",
        "dtype": "f32"
      }
    }
  ],
  "outputPorts": [
    {
      "name": "Duty_A",
      "description": "Phase A duty cycle (0-100%).",
      "direction": "output",
      "type": {
        "quantity": "dimensionless",
        "frame": "scalar",
        "dtype": "f32"
      }
    },
    {
      "name": "Duty_B",
      "description": "Phase B duty cycle (0-100%).",
      "direction": "output",
      "type": {
        "quantity": "dimensionless",
        "frame": "scalar",
        "dtype": "f32"
      }
    },
    {
      "name": "Duty_C",
      "description": "Phase C duty cycle (0-100%).",
      "direction": "output",
      "type": {
        "quantity": "dimensionless",
        "frame": "scalar",
        "dtype": "f32"
      }
    }
  ],
  "parameterTypes": {
    "ModeId": {
      "description": "This modulator's slot in the sequencer ladder (six-step = 1).",
