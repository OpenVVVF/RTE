{
  "id": "control.mpcc",
  "displayName": "FCS-MPCC (Three-Phase PMSM)",
  "defaultName": "Mpcc",
  "maxInstances": 1,
  "isEntryPoint": false,
  "domain": "tim_isr",
  "inputPorts": [
    {
      "name": "I_D",
      "direction": "input",
      "type": {
        "quantity": "current",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "Measured d-axis current in amperes."
    },
    {
      "name": "I_Q",
      "direction": "input",
      "type": {
        "quantity": "current",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "Measured q-axis current in amperes."
    },
    {
      "name": "I_D_Ref",
      "direction": "input",
      "type": {
        "quantity": "current",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "d-axis current reference in amperes."
    },
    {
      "name": "I_Q_Ref",
      "direction": "input",
      "type": {
        "quantity": "current",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "q-axis current reference in amperes."
    },
    {
      "name": "Theta_E",
      "direction": "input",
      "type": {
        "quantity": "dimensionless",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "Electrical rotor angle in radians."
    },
    {
      "name": "Omega_E",
      "direction": "input",
      "type": {
        "quantity": "angular_velocity",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "Electrical rotor speed in radians per second."
    },
    {
      "name": "V_Dc",
      "direction": "input",
      "type": {
        "quantity": "voltage",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "DC-link voltage in volts."
    },
    {
      "name": "Enable",
      "direction": "input",
      "type": {
        "quantity": "boolean",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "Controller enable (1 = run, 0 = hold previous switch states)."
    }
  ],
  "outputPorts": [
    {
      "name": "S_A",
      "direction": "output",
      "type": {
        "quantity": "boolean",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "Phase A high-side switch state."
    },
    {
      "name": "S_B",
      "direction": "output",
      "type": {
        "quantity": "boolean",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "Phase B high-side switch state."
    },
    {
      "name": "S_C",
      "direction": "output",
      "type": {
        "quantity": "boolean",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "Phase C high-side switch state."
    },
    {
      "name": "State_Index",
      "direction": "output",
      "type": {
        "quantity": "dimensionless",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "Selected switching-state index (0-7)."
    },
    {
      "name": "Pred_I_D",
      "direction": "output",
      "type": {
        "quantity": "current",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "Predicted d-axis current for the selected state."
    },
    {
      "name": "Pred_I_Q",
      "direction": "output",
      "type": {
        "quantity": "current",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "Predicted q-axis current for the selected state."
    },
    {
      "name": "Cost",
      "direction": "output",
      "type": {
        "quantity": "dimensionless",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "Cost of the selected switching state."
    },
    {
      "name": "V_Alpha",
      "direction": "output",
      "type": {
        "quantity": "voltage",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "Selected voltage vector, alpha component."
    },
    {
      "name": "V_Beta",
      "direction": "output",
      "type": {
        "quantity": "voltage",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "Selected voltage vector, beta component."
    },
    {
      "name": "V_D",
      "direction": "output",
      "type": {
        "quantity": "voltage",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "Selected voltage vector, d component."
    },
    {
      "name": "V_Q",
      "direction": "output",
      "type": {
        "quantity": "voltage",
        "frame": "scalar",
        "dtype": "f32"
      },
      "description": "Selected voltage vector, q component."
    }
  ],
  "parameterTypes": {
    "Ts": {
      "quantity": "dimensionless",
      "frame": "scalar",
      "dtype": "f32",
      "description": "Control sample period in seconds."
    },
    "Rs": {
      "quantity": "dimensionless",
      "frame": "scalar",
      "dtype": "f32",
      "description": "Stator phase resistance in ohms."
    },
    "Ld": {
      "quantity": "dimensionless",
      "frame": "scalar",
      "dtype": "f32",
      "description": "d-axis inductance in henrys."
    },
    "Lq": {
      "quantity": "dimensionless",
      "frame": "scalar",
      "dtype": "f32",
      "description": "q-axis inductance in henrys."
    },
    "PsiF": {
      "quantity": "dimensionless",
      "frame": "scalar",
      "dtype": "f32",
      "description": "Permanent-magnet flux linkage in webers."
    },
    "I_Base": {
      "quantity": "dimensionless",
      "frame": "scalar",
      "dtype": "f32",
      "description": "Current normalization base in amperes."
    },
    "I_Max": {
      "quantity": "dimensionless",
      "frame": "scalar",
      "dtype": "f32",
      "description": "Soft current limit in amperes."
    },
    "Mode": {
      "quantity": "dimensionless",
      "frame": "scalar",
      "dtype": "f32",
      "description": "MPCC mode: 0=one-step, 1=delay-compensated, 2=back-EMF-compensated, 3=optimal-duty-cycle."
    }
  },
  "description": "Finite-control-set model-predictive current control for a three-phase PMSM."
}
