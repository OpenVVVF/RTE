          "direction": "input",
          "name": "Poles",
          "type": {
            "quantity": "dimensionless",
            "frame": "scalar",
            "dtype": "f32"
          },
          "optional": true
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 1,
      "outputPorts": [
        {
          "direction": "output",
          "name": "ThetaElec",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        }
      ],
      "parameterTypes": {
        "EncoderSign": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "Poles": {
          "dtype": "f32",
          "frame": "scalar",
