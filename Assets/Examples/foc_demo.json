    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Space Vector PWM",
      "domain": "",
      "id": "math.svpwm",
      "inlineCode": "const float v_a = v_alpha_beta.beta.in(au::volts) / vdc.in(au::volts);\nconst float v_b = (-0.5f * v_alpha_beta.beta + 0.86602540378f * v_alpha_beta.alpha).in(au::volts) / vdc.in(au::volts);\nconst float v_c = (-0.5f * v_alpha_beta.beta - 0.86602540378f * v_alpha_beta.alpha).in(au::volts) / vdc.in(au::volts);\n\nfloat v_min = v_a;\nif (v_b < v_min) v_min = v_b;\nif (v_c < v_min) v_min = v_c;\n\nfloat v_max = v_a;\nif (v_b > v_max) v_max = v_b;\nif (v_c > v_max) v_max = v_c;\n\nconst float v_offset = 0.5f * (v_min + v_max);\n\nduty_a = 0.5f + (v_a - v_offset);\nduty_b = 0.5f + (v_b - v_offset);\nduty_c = 0.5f + (v_c - v_offset);\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "v_alpha_beta",
          "type": {
            "dtype": "f32",
            "frame": "alpha_beta",
            "quantity": "voltage"
          }
        },
        {
          "direction": "input",
          "name": "vdc",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "duty_a",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        },
        {
          "direction": "output",
          "name": "duty_b",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        },
        {
          "direction": "output",
          "name": "duty_c",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        }
      ]
    },
