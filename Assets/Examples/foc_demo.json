  "name": "foc_demo",
  "nodeTypes": [
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "PI Controller",
      "domain": "",
      "id": "control.pi",
      "inlineCode": "const float error = setpoint - measurement;\nintegral += error;\nfloat raw_output = kp * error + ki * integral;\nif (raw_output > output_max) raw_output = output_max;\nif (raw_output < output_min) raw_output = output_min;\noutput = raw_output;\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "setpoint",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        },
        {
          "direction": "input",
          "name": "measurement",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "output",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        }
      ],
      "parameterTypes": {
        "ki": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "kp": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "output_max": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "output_min": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        }
      }
    },
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Encoder Decoder",
      "domain": "",
      "id": "hw.encoder.decode",
      "inlineCode": "const float counts_per_rad = counts_per_rev / 6.28318530718f;\nconst float dt_s = sample_time_s;\n\ntheta = static_cast<float>(raw_counts) / counts_per_rad;\n\nconst float delta = static_cast<float>(raw_counts) - prev_counts;\nomega = rte::RadiansPerSecond(delta / (counts_per_rad * dt_s));\nprev_counts = static_cast<float>(raw_counts);\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "raw_counts",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 1,
      "outputPorts": [
        {
          "direction": "output",
          "name": "theta",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        },
        {
          "direction": "output",
          "name": "omega",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "angular_velocity"
          }
        }
      ],
      "parameterTypes": {
        "counts_per_rev": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "sample_time_s": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        }
      }
    },
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Phase Currents (ISR)",
      "domain": "adc_isr",
      "id": "hw.adc.phase_currents",
      "inlineCode": "// ADC1 injected: U signal CH4 (rank 1), V signal CH3 (rank 2)\n// ADC2 injected: U reference CH8 (rank 1), V reference CH7 (rank 2)\n// Triggered by TIM1 TRGO at PWM bottom; read in ADC ISR.\nstatic constexpr float ADC_VREF = 3.3f;\nstatic constexpr float DIVIDER = 2.0f / 3.0f;\nstatic constexpr float SENSITIVITY_VA = 1.042e-3f;  // LA37S600\nstatic constexpr float COUNTS_FULL = 65535.0f;\n\nconst float scale = (ADC_VREF / COUNTS_FULL) / (DIVIDER * SENSITIVITY_VA);\n\nconst uint32_t raw_u_sig = platform_adc_get_injected_u_sig();\nconst uint32_t raw_v_sig = platform_adc_get_injected_v_sig();\nconst uint32_t raw_u_ref = platform_adc_get_injected_u_ref();\nconst uint32_t raw_v_ref = platform_adc_get_injected_v_ref();\n\nconst rte::Current iu_raw = rte::Amperes((static_cast<float>(raw_u_sig) - static_cast<float>(raw_u_ref)) * scale);\nconst rte::Current iv_raw = rte::Amperes((static_cast<float>(raw_v_sig) - static_cast<float>(raw_v_ref)) * scale);\n\n// Subtract calibrated zero-current offsets from the base image's startup calibration.\nconst rte::Current calibrated_offset_u = rte::Amperes(platform_adc_get_offset_u_a());\nconst rte::Current calibrated_offset_v = rte::Amperes(platform_adc_get_offset_v_a());\nconst rte::Current iu_a = iu_raw - calibrated_offset_u;\nconst rte::Current iv_a = iv_raw - calibrated_offset_v;\n\n// W is computed from the two measured phases (three-wire balanced load).\nconst rte::Current iw_a = rte::Amperes(-(iu_a.in(au::amperes) + iv_a.in(au::amperes)));\n\ni_abc.a = iu_a;\ni_abc.b = iv_a;\ni_abc.c = iw_a;\n",
      "inputPorts": [],
      "isEntryPoint": true,
      "maxInstances": 1,
      "outputPorts": [
        {
          "direction": "output",
          "name": "i_abc",
          "type": {
            "dtype": "f32",
            "frame": "abc",
            "quantity": "current"
          }
        }
      ],
      "parameterTypes": {
        "offset_u_a": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "current"
        },
        "offset_v_a": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "current"
        }
      }
    },
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Set PWM Duty Cycles",
      "domain": "tim_isr",
      "id": "hw.pwm.set_duty",
      "inlineCode": "platform_pwm_set(duty_a, duty_b, duty_c);\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "duty_a",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        },
        {
          "direction": "input",
          "name": "duty_b",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        },
        {
          "direction": "input",
          "name": "duty_c",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 1,
      "outputPorts": []
    },
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Clarke Transform",
      "domain": "",
      "id": "math.clarke",
      "inlineCode": "i_alpha_beta.alpha = i_abc.a;\ni_alpha_beta.beta = (i_abc.b - i_abc.c) * 0.57735026919f;\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "i_abc",
          "type": {
            "dtype": "f32",
            "frame": "abc",
            "quantity": "current"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "i_alpha_beta",
          "type": {
            "dtype": "f32",
            "frame": "alpha_beta",
            "quantity": "current"
          }
        }
      ]
    },
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Inverse Clarke Transform",
      "domain": "",
      "id": "math.inverse_clarke",
      "inlineCode": "v_abc.a = v_alpha_beta.alpha;\nv_abc.b = -0.5f * v_alpha_beta.alpha + 0.86602540378f * v_alpha_beta.beta;\nv_abc.c = -0.5f * v_alpha_beta.alpha - 0.86602540378f * v_alpha_beta.beta;\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "v_alpha_beta",
          "type": {
            "dtype": "f32",
            "frame": "alpha_beta",
            "quantity": "voltage"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "v_abc",
          "type": {
            "dtype": "f32",
            "frame": "abc",
            "quantity": "voltage"
          }
        }
      ]
    },
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Inverse Park Transform",
      "domain": "",
      "id": "math.inverse_park",
      "inlineCode": "const float cos_theta = cosf(theta);\nconst float sin_theta = sinf(theta);\nv_alpha_beta.alpha = v_dq.d * cos_theta - v_dq.q * sin_theta;\nv_alpha_beta.beta = v_dq.d * sin_theta + v_dq.q * cos_theta;\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "v_dq",
          "type": {
            "dtype": "f32",
            "frame": "dq",
            "quantity": "voltage"
          }
        },
        {
          "direction": "input",
          "name": "theta",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "v_alpha_beta",
          "type": {
            "dtype": "f32",
            "frame": "alpha_beta",
            "quantity": "voltage"
          }
        }
      ]
    },
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Park Transform",
      "domain": "",
      "id": "math.park",
      "inlineCode": "const float cos_theta = cosf(theta);\nconst float sin_theta = sinf(theta);\ni_dq.d = i_alpha_beta.alpha * cos_theta + i_alpha_beta.beta * sin_theta;\ni_dq.q = -i_alpha_beta.alpha * sin_theta + i_alpha_beta.beta * cos_theta;\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "i_alpha_beta",
          "type": {
            "dtype": "f32",
            "frame": "alpha_beta",
            "quantity": "current"
          }
        },
        {
          "direction": "input",
          "name": "theta",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
