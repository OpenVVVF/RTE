    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Space Vector PWM",
      "domain": "",
      "id": "math.svpwm",
      "inlineCode": "const float sqrt3 = 1.7320508075688772f;\nconst float valpha = v_alpha.in(au::volts);\nconst float vbeta  = v_beta.in(au::volts);\nconst float vdc_v  = vdc.in(au::volts);\n\nif (vdc_v <= 1.0f) {\n    duty_a = 50.0f;\n    duty_b = 50.0f;\n    duty_c = 50.0f;\n} else {\n    // Clamp to the SVPWM linear modulation limit (Vdc / sqrt3) with a 5% margin.\n    const float v_max_linear = (vdc_v / sqrt3) * 0.95f;\n    float va = valpha;\n    float vb = vbeta;\n    const float v_albe_sq = va * va + vb * vb;\n    if (v_albe_sq > v_max_linear * v_max_linear && v_albe_sq > 1e-12f) {\n        const float scale = v_max_linear / sqrtf(v_albe_sq);\n        va *= scale;\n        vb *= scale;\n    }\n\n    // Inverse Clarke: alpha/beta -> A/B/C.\n    const float v_a = va;\n    const float v_b = -0.5f * va + 0.5f * sqrt3 * vb;\n    const float v_c = -0.5f * va - 0.5f * sqrt3 * vb;\n\n    // Min-max zero-sequence injection.\n    float v_min = v_a;\n    if (v_b < v_min) v_min = v_b;\n    if (v_c < v_min) v_min = v_c;\n    float v_max = v_a;\n    if (v_b > v_max) v_max = v_b;\n    if (v_c > v_max) v_max = v_c;\n    const float v_offset = 0.5f * (v_min + v_max);\n\n    duty_a = 50.0f + 50.0f * (v_a - v_offset) / vdc_v;\n    duty_b = 50.0f + 50.0f * (v_b - v_offset) / vdc_v;\n    duty_c = 50.0f + 50.0f * (v_c - v_offset) / vdc_v;\n}\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "v_alpha",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "input",
          "name": "v_beta",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "input",
          "name": "vdc",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "duty_a",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        },
        {
          "direction": "output",
          "name": "duty_b",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        },
        {
          "direction": "output",
          "name": "duty_c",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        }
      ]
    },
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "PI Controller (Current)",
      "domain": "",
      "id": "control.pi_current",
      "inlineCode": "const float error = (setpoint - measurement).in(au::amperes);\nintegral += error * dt_s;\n\nfloat raw_output = kp * error + ki * integral;\n\n/* Dynamic voltage limit derived from DC-link voltage, matching the base\n * image's VectorPIController convention: max = Vdc * 0.5 * MaxModulation. */\nconst float vdc = platform_get_dc_link_voltage();\nconst float dynamic_max = vdc * 0.5f * 0.9f;\nconst float max_limit = (dynamic_max < output_max) ? dynamic_max : output_max;\nconst float min_limit = (-dynamic_max > output_min) ? -dynamic_max : output_min;\n\nfloat limited_output = raw_output;\nif (limited_output > max_limit) limited_output = max_limit;\nif (limited_output < min_limit) limited_output = min_limit;\n\n/* Back-calculation anti-windup (matches base-image VectorPIController). */\nif (ki > 0.0001f && kp > 0.0001f) {\n    const float excess = raw_output - limited_output;\n    integral -= excess * dt_s / (kp * ki);\n}\n\noutput = rte::Volts(limited_output);\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "setpoint",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        },
        {
          "direction": "input",
          "name": "measurement",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "output",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        }
      ],
      "parameterTypes": {
        "dt_s": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "integral": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "ki": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "kp": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "output_max": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "output_min": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        }
      }
    },
