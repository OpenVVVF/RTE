    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Clarke Transform",
      "domain": "",
      "id": "math.clarke",
      "inlineCode": "I_Alpha = I_A;\nI_Beta = (I_B - I_C) * 0.57735026919f;\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "I_A",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        },
        {
          "direction": "input",
          "name": "I_B",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        },
        {
          "direction": "input",
          "name": "I_C",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "I_Alpha",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        },
        {
          "direction": "output",
          "name": "I_Beta",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        }
      ],
      "parameterTypes": {}
    },
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Inverse Clarke Transform",
      "domain": "",
      "id": "math.inverse_clarke",
      "inlineCode": "V_A = V_Alpha;\nV_B = -0.5f * V_Alpha + 0.86602540378f * V_Beta;\nV_C = -0.5f * V_Alpha - 0.86602540378f * V_Beta;\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "V_Alpha",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "input",
          "name": "V_Beta",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "V_A",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "output",
          "name": "V_B",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "output",
          "name": "V_C",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        }
      ],
      "parameterTypes": {}
    },
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Inverse Park Transform",
      "domain": "",
      "id": "math.inverse_park",
      "inlineCode": "const float cos_theta = cosf(Theta);\nconst float sin_theta = sinf(Theta);\nV_Alpha = V_D * cos_theta - V_Q * sin_theta;\nV_Beta = V_D * sin_theta + V_Q * cos_theta;\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "V_D",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "input",
          "name": "V_Q",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "input",
          "name": "Theta",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "V_Alpha",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "output",
          "name": "V_Beta",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        }
      ],
      "parameterTypes": {}
    },
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Park Transform",
      "domain": "",
      "id": "math.park",
      "inlineCode": "const float cos_theta = cosf(Theta);\nconst float sin_theta = sinf(Theta);\nI_D = I_Alpha * cos_theta + I_Beta * sin_theta;\nI_Q = -I_Alpha * sin_theta + I_Beta * cos_theta;\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "I_Alpha",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        },
        {
          "direction": "input",
          "name": "I_Beta",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        },
        {
          "direction": "input",
          "name": "Theta",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "I_D",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        },
        {
          "direction": "output",
