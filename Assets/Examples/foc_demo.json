    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Space Vector PWM",
      "domain": "",
      "id": "math.svpwm",
      "inlineCode": "const float sqrt3 = 1.7320508075688772f;\nconst float valpha = V_Alpha.in(au::volts);\nconst float vbeta  = V_Beta.in(au::volts);\nconst float vdc_v  = V_Dc.in(au::volts);\n\nif (vdc_v <= 1.0f) {\n    Duty_A = 50.0f;\n    Duty_B = 50.0f;\n    Duty_C = 50.0f;\n} else {\n    // Clamp to the SVPWM linear modulation limit (Vdc / sqrt3) with a 5% margin.\n    const float v_max_linear = (vdc_v / sqrt3) * 0.95f;\n    float va = valpha;\n    float vb = vbeta;\n    const float v_albe_sq = va * va + vb * vb;\n    if (v_albe_sq > v_max_linear * v_max_linear && v_albe_sq > 1e-12f) {\n        const float scale = v_max_linear / sqrtf(v_albe_sq);\n        va *= scale;\n        vb *= scale;\n    }\n\n    // Inverse Clarke: alpha/beta -> A/B/C.\n    const float v_a = va;\n    const float v_b = -0.5f * va + 0.5f * sqrt3 * vb;\n    const float v_c = -0.5f * va - 0.5f * sqrt3 * vb;\n\n    // Min-max zero-sequence injection.\n    float v_min = v_a;\n    if (v_b < v_min) v_min = v_b;\n    if (v_c < v_min) v_min = v_c;\n    float v_max = v_a;\n    if (v_b > v_max) v_max = v_b;\n    if (v_c > v_max) v_max = v_c;\n    const float v_offset = 0.5f * (v_min + v_max);\n\n    Duty_A = 50.0f + 50.0f * (v_a - v_offset) / vdc_v;\n    Duty_B = 50.0f + 50.0f * (v_b - v_offset) / vdc_v;\n    Duty_C = 50.0f + 50.0f * (v_c - v_offset) / vdc_v;\n}\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "V_Alpha",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "input",
          "name": "V_Beta",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "input",
          "name": "V_Dc",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "Duty_A",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        },
        {
          "direction": "output",
          "name": "Duty_B",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        },
        {
          "direction": "output",
          "name": "Duty_C",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        }
      ],
      "parameterTypes": {}
