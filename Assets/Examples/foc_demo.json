    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "PI Controller (Current)",
      "domain": "",
      "id": "control.pi_current",
      "inlineCode": "const float error = (setpoint - measurement).in(au::amperes);\nintegral += error;\nfloat raw_output = kp * error + ki * integral;\nif (raw_output > output_max) raw_output = output_max;\nif (raw_output < output_min) raw_output = output_min;\noutput = rte::Volts(raw_output);\n",
