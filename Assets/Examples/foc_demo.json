    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Encoder Electrical Angle",
      "domain": "",
      "id": "math.encoder_elec_angle",
      "inlineCode": "/* Wrap the mechanical encoder angle to [0, 2*pi). */\nconst float two_pi = 6.28318530718f;\nfloat theta = fmodf(theta_mech, two_pi);\nif (theta < 0.0f) theta += two_pi;\n\n/* Electrical angle = offset + sign * encoder_angle * pole_pairs.\n * Matches the base-image FocController convention. */\nfloat elec = offset_rad + encoder_sign * theta * pole_pairs;\n\n/* Wrap the electrical angle to [0, 2*pi). */\nelec = fmodf(elec, two_pi);\nif (elec < 0.0f) elec += two_pi;\n\ntheta_elec = elec;\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "theta_mech",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 1,
      "outputPorts": [
        {
          "direction": "output",
          "name": "theta_elec",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        }
      ],
      "parameterTypes": {
        "encoder_sign": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "offset_rad": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "pole_pairs": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        }
      }
    },
