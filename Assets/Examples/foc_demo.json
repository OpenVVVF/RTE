    },
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Clarke Transform",
      "domain": "",
      "id": "math.clarke",
      "inlineCode": "i_alpha = ia;\ni_beta = (ib - ic) * 0.57735026919f;\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "ia",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        },
        {
          "direction": "input",
          "name": "ib",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        },
        {
          "direction": "input",
          "name": "ic",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "i_alpha",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        },
        {
          "direction": "output",
          "name": "i_beta",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        }
      ]
    },
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Inverse Clarke Transform",
      "domain": "",
      "id": "math.inverse_clarke",
      "inlineCode": "va = v_alpha;\nvb = -0.5f * v_alpha + 0.86602540378f * v_beta;\nvc = -0.5f * v_alpha - 0.86602540378f * v_beta;\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "v_alpha",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "input",
          "name": "v_beta",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "va",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "output",
          "name": "vb",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "output",
          "name": "vc",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        }
      ]
    },
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Inverse Park Transform",
      "domain": "",
      "id": "math.inverse_park",
      "inlineCode": "const float cos_theta = cosf(theta);\nconst float sin_theta = sinf(theta);\nv_alpha = vd * cos_theta - vq * sin_theta;\nv_beta = vd * sin_theta + vq * cos_theta;\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "vd",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "input",
          "name": "vq",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "input",
          "name": "theta",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "v_alpha",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "output",
          "name": "v_beta",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        }
      ]
    },
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Park Transform",
      "domain": "",
      "id": "math.park",
      "inlineCode": "const float cos_theta = cosf(theta);\nconst float sin_theta = sinf(theta);\nid = i_alpha * cos_theta + i_beta * sin_theta;\niq = -i_alpha * sin_theta + i_beta * cos_theta;\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "i_alpha",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        },
        {
          "direction": "input",
          "name": "i_beta",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        },
        {
          "direction": "input",
          "name": "theta",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "id",
          "type": {
