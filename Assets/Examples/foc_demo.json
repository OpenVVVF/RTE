    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "PI Controller (Current)",
      "domain": "",
      "id": "control.pi_current",
      "inlineCode": "const float error = (Setpoint - Measurement).in(au::amperes);\nIntegral += error * Dt;\n\nfloat raw_output = Kp * error + Ki * Integral;\n\n/* Dynamic voltage limit derived from DC-link voltage, matching the base\n * image's VectorPIController convention: max = Vdc * 0.5 * MaxModulation. */\nconst float vdc = platform_get_dc_link_voltage();\nconst float dynamic_max = vdc * 0.5f * 0.9f;\nconst float max_limit = (dynamic_max < OutputMax) ? dynamic_max : OutputMax;\nconst float min_limit = (-dynamic_max > OutputMin) ? -dynamic_max : OutputMin;\n\nfloat limited_output = raw_output;\nif (limited_output > max_limit) limited_output = max_limit;\nif (limited_output < min_limit) limited_output = min_limit;\n\n/* Back-calculation anti-windup, scaled by AwGain (0 disables; 1.0 matches\n * the base-image VectorPIController). */\nif (Ki > 0.0001f && Kp > 0.0001f && AwGain > 0.0f) {\n    const float excess = raw_output - limited_output;\n    Integral -= excess * Dt * AwGain / (Kp * Ki);\n}\n\nOutput = rte::Volts(limited_output);\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "Setpoint",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        },
        {
          "direction": "input",
          "name": "Measurement",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "Output",
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        }
      ],
      "parameterTypes": {
        "Dt": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "Integral": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "Ki": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "Kp": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "OutputMax": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "OutputMin": {
          "dtype": "f32",
          "frame": "scalar",
          "quantity": "dimensionless"
        },
        "AwGain": {
          "quantity": "dimensionless",
          "frame": "scalar",
          "dtype": "f32"
        }
      }
    },
