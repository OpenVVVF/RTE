{
  "name": "sensor_telemetry_demo",
  "nodeTypes": [
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Encoder",
      "domain": "",
      "id": "Sensors.Encoder",
      "inlineCode": "/* Mechanical angle [rad] and speed [rpm] from the base-image encoder driver. */\nTheta = platform_get_encoder_angle_latest() * 0.01745329251f;  // deg -> rad\nOmega = platform_get_motor_rpm();\n",
      "inputPorts": [],
      "isEntryPoint": true,
      "maxInstances": 0,
      "outputPorts": [
        {
          "name": "Theta",
          "direction": "output",
          "type": {
            "quantity": "dimensionless",
            "frame": "scalar",
            "dtype": "f32"
          }
        },
        {
          "name": "Omega",
          "direction": "output",
          "type": {
            "quantity": "dimensionless",
            "frame": "scalar",
            "dtype": "f32"
          }
        }
      ],
      "parameterTypes": {}
    },
    {
      "classDefinition": "",
      "classHeader": "",
      "constructorCode": "",
      "displayName": "Phase Currents",
      "domain": "",
      "id": "Sensors.PhaseCurrents",
      "inlineCode": "float iu_f = 0.0f;\nfloat iv_f = 0.0f;\nfloat iw_f = 0.0f;\nif (platform_get_phase_currents(&iu_f, &iv_f, &iw_f)) {\n    const float polarity = InvertPolarity ? -1.0f : 1.0f;\n    I_A = rte::Amperes(polarity * iu_f);\n    I_B = rte::Amperes(polarity * iv_f);\n    I_C = rte::Amperes(polarity * iw_f);\n}\n",
      "inputPorts": [],
      "isEntryPoint": true,
      "maxInstances": 1,
      "outputPorts": [
        {
          "name": "I_A",
          "direction": "output",
          "type": {
            "quantity": "current",
            "frame": "scalar",
            "dtype": "f32"
          }
        },
        {
          "name": "I_B",
          "direction": "output",
          "type": {
            "quantity": "current",
            "frame": "scalar",
            "dtype": "f32"
          }
        },
        {
          "name": "I_C",
          "direction": "output",
          "type": {
            "quantity": "current",
            "frame": "scalar",
            "dtype": "f32"
          }
        }
      ],
      "parameterTypes": {
        "InvertPolarity": {
          "description": "Negate all three phase currents to match the FOC sign convention on hardware with inverted current sensors.",
          "quantity": "boolean",
          "frame": "scalar",
          "dtype": "f32"
        }
      }
    }
  ],
