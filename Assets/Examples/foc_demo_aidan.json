            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "input",
          "name": "V_Q",
          "optional": false,
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "input",
          "name": "Theta",
          "optional": false,
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "dimensionless"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
        {
          "direction": "output",
          "name": "V_Alpha",
          "optional": false,
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "voltage"
          }
        },
        {
          "direction": "output",
