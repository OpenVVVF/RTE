      "classHeader": "",
      "constructorCode": "",
      "displayName": "Clarke Transform",
      "domain": "",
      "id": "Transforms.Clarke",
      "inlineCode": "I_Alpha = I_A;\nI_Beta = (I_B - I_C) * 0.57735026919f;\n",
      "inputPorts": [
        {
          "direction": "input",
          "name": "I_A",
          "optional": false,
          "type": {
