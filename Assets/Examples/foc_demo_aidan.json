            "quantity": "current"
          }
        },
        {
          "direction": "input",
          "name": "I_B",
          "optional": false,
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        },
        {
          "direction": "input",
          "name": "I_C",
          "optional": false,
          "type": {
            "dtype": "f32",
            "frame": "scalar",
            "quantity": "current"
          }
        }
      ],
      "isEntryPoint": false,
      "maxInstances": 0,
      "outputPorts": [
