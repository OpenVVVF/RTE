{
  "id": "Plant.Thermal.TwoNodeCauer",
  "displayName": "Thermal (two-node Cauer)",
  "defaultName": "Thermal",
  "description": "Baseplate thermal plant as a two-node Cauer chain (plate+NTC -> heatsink mass -> ambient) plus the twin's NTC spot-offset view: physically the two NTC channels sit at different gasket/neighborhood spots; each channel's reported temperature is the plate node plus its own offset.",
  "maxInstances": 0,
  "isEntryPoint": false,
  "inputPorts": [
    {"name": "P_Heat", "description": "Heat power into the plate node, W.", "direction": "input", "type": {"quantity": "dimensionless", "frame": "scalar", "dtype": "f32"}}
  ],
  "outputPorts": [
    {"name": "T_Plate", "description": "Plate/sensor-node temperature, C.", "direction": "output", "type": {"quantity": "dimensionless", "frame": "scalar", "dtype": "f32"}},
    {"name": "T_Sink", "description": "Heatsink mass temperature, C.", "direction": "output", "type": {"quantity": "dimensionless", "frame": "scalar", "dtype": "f32"}},
    {"name": "T_Meas1", "description": "NTC channel 1 readout (plate + off1), C.", "direction": "output", "type": {"quantity": "dimensionless", "frame": "scalar", "dtype": "f32"}},
    {"name": "T_Meas2", "description": "NTC channel 2 readout (plate + off2), C.", "direction": "output", "type": {"quantity": "dimensionless", "frame": "scalar", "dtype": "f32"}}
  ],
  "parameterTypes": {
    "R12_KW":   {"description": "Plate->sink thermal resistance, K/W.", "dtype": "f32", "frame": "scalar", "quantity": "dimensionless"},
    "C1_JK":    {"description": "Plate thermal capacitance, J/K.", "dtype": "f32", "frame": "scalar", "quantity": "dimensionless"},
    "R2_KW":    {"description": "Sink->ambient thermal resistance, K/W.", "dtype": "f32", "frame": "scalar", "quantity": "dimensionless"},
    "C2_JK":    {"description": "Sink thermal capacitance, J/K.", "dtype": "f32", "frame": "scalar", "quantity": "dimensionless"},
    "TAmb_C":   {"description": "Ambient temperature, C.", "dtype": "f32", "frame": "scalar", "quantity": "dimensionless"},
    "T1_0_C":   {"description": "Initial plate temperature, C.", "dtype": "f32", "frame": "scalar", "quantity": "dimensionless"},
    "T2_0_C":   {"description": "Initial sink temperature, C.", "dtype": "f32", "frame": "scalar", "quantity": "dimensionless"},
    "Off1":      {"description": "NTC ch1 spot offset, C.", "dtype": "f32", "frame": "scalar", "quantity": "dimensionless"},
    "Off2Idle":  {"description": "NTC ch2 idle spot offset, C (recorded +3.4 at idle).", "dtype": "f32", "frame": "scalar", "quantity": "dimensionless"},
    "Off2Slope": {"description": "ch2 load-relief slope, K per K of plate rise above the knee (recorded 0.268); 0 = constant offset.", "dtype": "f32", "frame": "scalar", "quantity": "dimensionless"},
    "Off2Knee_C":{"description": "offset knee above ambient, C (4.9 anchor).", "dtype": "f32", "frame": "scalar", "quantity": "dimensionless"}
  }
}
