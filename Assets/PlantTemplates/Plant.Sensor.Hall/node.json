{
  "id": "Plant.Sensor.Hall",
  "displayName": "Hall Current Sensor (quantized)",
  "defaultName": "CurrentSensor",
  "description": "Tamura-class hall current measurement: true phase current with offset + quantization to LSB and clamp (saturates to range; post-fault rails behavior lives in Plant.Fault.Point injection). Matches the recorded 0.07 A/LSB quantization at ±1200 A range.",
  "maxInstances": 0,
  "isEntryPoint": false,
  "inputPorts": [
    {"name": "I_True", "description": "True phase current, A.", "direction": "input", "type": {"quantity": "current", "frame": "scalar", "dtype": "f32"}},
    {"name": "Rail", "description": ">=0.5 drives the isolated-rail phantom course (post-fault artifact mode, ±range).", "direction": "input", "type": {"quantity": "dimensionless", "frame": "scalar", "dtype": "f32"}, "optional": true}
  ],
  "outputPorts": [
    {"name": "I_Meas", "description": "Measured phase current, A.", "direction": "output", "type": {"quantity": "current", "frame": "scalar", "dtype": "f32"}}
  ],
  "parameterTypes": {
    "Lsb_A":   {"description": "Quantization step, A.", "dtype": "f32", "frame": "scalar", "quantity": "dimensionless"},
    "Range_A": {"description": "Sensor range, ±A.", "dtype": "f32", "frame": "scalar", "quantity": "dimensionless"},
    "Offset_A":{"description": "DC offset, A.", "dtype": "f32", "frame": "scalar", "quantity": "dimensionless"}
  }
}
