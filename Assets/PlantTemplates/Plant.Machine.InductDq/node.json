{
  "id": "Plant.Machine.InductDq",
  "displayName": "Induction Machine (stationary frame)",
  "defaultName": "Induction",
  "description": "Three-phase induction machine solved in the stationary frame (wf=0) for numerical robustness at line frequency: slip enters via machine speed; air-gap power returns at the command (synchronous) speed on the Omega_Cmd input. Matches twin/plant/induction.py.",
  "maxInstances": 0,
  "isEntryPoint": false,
  "inputPorts": [
    {"name": "V_U", "direction": "input", "type": {"quantity": "voltage", "frame": "scalar", "dtype": "f32"}},
    {"name": "V_V", "direction": "input", "type": {"quantity": "voltage", "frame": "scalar", "dtype": "f32"}},
    {"name": "V_W", "direction": "input", "type": {"quantity": "voltage", "frame": "scalar", "dtype": "f32"}},
    {"name": "Omega_Elec", "description": "Electrical shaft speed, rad/s (mech*pp from the dyno / free shaft).", "direction": "input", "type": {"quantity": "dimensionless", "frame": "scalar", "dtype": "f32"}},
    {"name": "Omega_Cmd", "description": "Command (synchronous) electrical speed, rad/s, from the V/Hz controller: drives the link-side air-gap power P_Elec = Torque * Omega_Cmd / Poles. Controller-side external: push per control period via set_input / PlantSetInput / rte sim 'plant-input'; unwired zero-binds (loss-only link draw).", "direction": "input", "type": {"quantity": "dimensionless", "frame": "scalar", "dtype": "f32"}, "optional": true},
    {"name": "OpenGates", "direction": "input", "type": {"quantity": "dimensionless", "frame": "scalar", "dtype": "f32"}, "optional": true}
  ],
  "outputPorts": [
    {"name": "I_U", "direction": "output", "type": {"quantity": "current", "frame": "scalar", "dtype": "f32"}},
    {"name": "I_V", "direction": "output", "type": {"quantity": "current", "frame": "scalar", "dtype": "f32"}},
    {"name": "I_W", "direction": "output", "type": {"quantity": "current", "frame": "scalar", "dtype": "f32"}},
    {"name": "Isd", "direction": "output", "type": {"quantity": "current", "frame": "scalar", "dtype": "f32"}},
    {"name": "Isq", "direction": "output", "type": {"quantity": "current", "frame": "scalar", "dtype": "f32"}},
    {"name": "Torque", "direction": "output", "type": {"quantity": "dimensionless", "frame": "scalar", "dtype": "f32"}},
