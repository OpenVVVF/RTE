    "Motor.Type": 2.0,
    "Motor.Resistance.Avg": 0.05,
    "Motor.Ld": 0.0001,
    "Motor.Lq": 0.0001,
    "Motor.Lambda": 0.008,
    "Motor.PMSM.Inductance.Ld": 0.0001,
